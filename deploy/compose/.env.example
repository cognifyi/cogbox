# Production control-plane environment. Copy to .env and fill EVERY value.
# Rule: no placeholder (changeme/supersecret/minioadmin) may remain —
# the `envcheck` service fails the boot otherwise.
# Generate secrets with:  openssl rand -hex 32

# --- Images ---
IMAGE_TAG=0.190.3

# --- Platform ---
DASHBOARD_URL=https://cogbox.example.com/dashboard
DASHBOARD_BASE_API_URL=https://cogbox.example.com
DEFAULT_REGION_ID=us
DEFAULT_REGION_NAME=us

# --- API data protection (32+ random bytes hex each) ---
ENCRYPTION_KEY=changeme-64-hex-chars
ENCRYPTION_SALT=changeme-64-hex-chars
HEALTH_CHECK_API_KEY=changeme-64-hex-chars
ADMIN_API_KEY=changeme-64-hex-chars

# --- Postgres (managed Cloud SQL recommended; else the compose db service) ---
DB_USERNAME=cogbox
DB_PASSWORD=changeme-strong-password
DB_DATABASE=cogbox

# --- Redis (Memorystore recommended; else the compose redis service) ---
REDIS_PASSWORD=changeme-strong-password

# --- Object storage (GCS bucket + HMAC keys, or self-hosted S3) ---
S3_REGION=auto
S3_ACCESS_KEY=changeme-gcs-hmac-access-key
S3_SECRET_KEY=changeme-gcs-hmac-secret
S3_DEFAULT_BUCKET=cogbox-platform

# --- Registries (BOOT-REQUIRED — API crashes in bootstrap without the URLs) ---
TRANSIENT_REGISTRY_URL=http://registry:6000
TRANSIENT_REGISTRY_ADMIN=admin
TRANSIENT_REGISTRY_PASSWORD=changeme-registry-password
TRANSIENT_REGISTRY_PROJECT_ID=cogbox
INTERNAL_REGISTRY_URL=http://registry:6000
INTERNAL_REGISTRY_ADMIN=admin
INTERNAL_REGISTRY_PASSWORD=changeme-registry-password
INTERNAL_REGISTRY_PROJECT_ID=cogbox

# --- Legacy global service keys (REQUIRED non-empty — every API-key request
# is compared against them first; then user/runner/region-hash lookups run) ---
# Single-region: set both EQUAL to that region's keys.
# Multi-region: set random values; real auth resolves via region hashes.
PROXY_API_KEY=changeme-64-hex-chars
SSH_GATEWAY_API_KEY=changeme-64-hex-chars

# --- Proxy defaults + default snapshot (served to proxies via /api/config;
# proxies fail to boot when templateUrl/defaultSnapshot are missing) ---
PROXY_DOMAIN=proxy.example.com
PROXY_TEMPLATE_URL=https://{{PORT}}-{{sandboxId}}.proxy.example.com
DEFAULT_SNAPSHOT=cognifyi/sandbox:latest-slim

# --- Feature flags (no PostHog needed): organization_infrastructure gates
# custom-region and custom-runner APIs — required for BYOC/multitenant ops ---
OPENFEATURE_FORCE_ENABLED_FLAGS=organization_infrastructure

# --- Identity: EXTERNAL OIDC only (Dex is evaluation-only) ---
# Any RS256 issuer works: Keycloak (self-hosted), Auth0, Entra ID, Okta, Google.
# The proxy fetches OIDC client/audience from the API itself, so only the API needs these.
OIDC_CLIENT_ID=cogbox
OIDC_ISSUER_BASE_URL=https://keycloak.example.com/realms/cogbox
OIDC_AUDIENCE=cogbox
# OIDC_CLIENT_SECRET: required for confidential clients (Auth0/Keycloak confidential).
# Leave empty for public clients.
OIDC_CLIENT_SECRET=
# --- Auth0 Management API (ONLY if dashboard user admin is backed by Auth0) ---
# Needs a Machine-to-Machine app authorized on the Auth0 Management API with
# read:users update:users read:connections scopes. Empty otherwise.
OIDC_MANAGEMENT_API_ENABLED=
OIDC_MANAGEMENT_API_CLIENT_ID=
OIDC_MANAGEMENT_API_CLIENT_SECRET=
OIDC_MANAGEMENT_API_AUDIENCE=

# --- Outbound mail (managed relay, e.g. SendGrid/SES/Mailgun) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_EMAIL_FROM=Cogbox Team <no-reply@example.com>

# --- Observability ---
OTEL_ENABLED=false
OTEL_COLLECTOR_URL=
OTEL_COLLECTOR_API_KEY=

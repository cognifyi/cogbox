#!/bin/bash
set -e

# Create necessary directories
mkdir -p /var/lib/cogbox/runner
mkdir -p /var/log/cogbox
mkdir -p /etc/cogbox

# Create default environment file if it doesn't exist
if [ ! -f /etc/cogbox/runner.env ]; then
    cat > /etc/cogbox/runner.env <<EOF
# Cogbox Runner Environment Variables
# Add your configuration here, for example:
# COGBOX_API_URL=https://api.cogbox.pazity.com
# COGBOX_RUNNER_TOKEN=your-token-here
EOF
    chmod 600 /etc/cogbox/runner.env
fi

# Reload systemd daemon
systemctl daemon-reload

echo "Cogbox Runner installed successfully"
echo ""
echo "Next steps:"
echo "1. Configure environment variables in /etc/cogbox/runner.env"
echo "2. Enable and start the service: systemctl enable --now cogbox-runner"
echo ""
echo "To check service status: systemctl status cogbox-runner"

exit 0

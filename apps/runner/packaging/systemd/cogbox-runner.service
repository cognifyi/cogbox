[Unit]
Description=Cogbox Runner Service
Documentation=https://github.com/cognifyi/cogbox
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/lib/cogbox/runner

# Binary location
ExecStart=/opt/cogbox/runner

# Environment file for configuration
EnvironmentFile=-/etc/cogbox/runner.env

# Restart policy
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cogbox/runner /var/log/cogbox /etc/iptables /tmp

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cogbox-runner

[Install]
WantedBy=multi-user.target

# Billing usage outbox (all values are placeholders; never commit real secrets)
#
# Rollout requires all three of:
#   - BILLING_USAGE_ENABLED=true (otherwise archiving and the relay stay inert)
#   - a non-empty BILLING_USAGE_ADMIN_KEY (sent to billing as X-Admin-Key)
#   - BILLING_USAGE_PRICE_VERSION (attached to every emitted usage event)
# Keep BILLING_USAGE_DRY_RUN=true until the outbox backlog has been validated.

BILLING_USAGE_ENABLED=false
BILLING_USAGE_DRY_RUN=true
BILLING_USAGE_ADMIN_KEY=
BILLING_USAGE_BASE_PATH=
BILLING_USAGE_PRICE_VERSION=

# Optional tuning
BILLING_USAGE_BATCH_SIZE=100
BILLING_USAGE_MAX_ATTEMPTS=8
BILLING_USAGE_BASE_BACKOFF_MS=1000
BILLING_USAGE_MAX_BACKOFF_MS=300000
BILLING_USAGE_SENT_RETENTION_DAYS=30
BILLING_USAGE_BACKLOG_ALERT_THRESHOLD=1000
